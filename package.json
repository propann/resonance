{
  "name": "resonance-pro-studio",
  "version": "1.0.0",
  "description": "Station professionnelle de gestion de samples, découpe de transitoires, kits OP-1/EP-133 et analyse DSP acoustique",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "desktop:dev": "cross-env RESONANCE_DEV_URL=http://localhost:3000 electron desktop/main.cjs",
    "desktop:start": "electron desktop/main.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/jszip": "^3.4.1",
    "@vitejs/plugin-react": "^5.0.4",
    "chokidar": "^5.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tone": "^15.1.22",
    "vite": "^6.2.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^37.10.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.2.3",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
